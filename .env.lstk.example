# Export LOCALSTACK_AUTH_TOKEN in your shell. Do not store it in this file.
WORKSPACE=lstk
DOMAIN_NAME=localhost.localstack.cloud
LOCALSTACK_IMAGE=localstack/localstack-pro:2026.07.0
LOCALSTACK_PERSISTENCE=1
LOCALSTACK_DEBUG=0
# LocalStack's edge gateway must allow the browser headers added by the shared web client.
EXTRA_CORS_ALLOWED_HEADERS=X-XSRF-TOKEN,X-Correlation-Id

# Single-platform images match Terraform's Lambda x86_64 architecture.
SERVICES_IMAGE_PLATFORM=linux/amd64
LAMBDA_IMAGE_PLATFORM=linux/amd64

JWT_ISSUER=eventpro
JWT_ACCESS_TTL_SECONDS=3600
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# LocalStack deployment forces non-live integration sentinels.
# Supply Stripe test-mode values from a protected shell/env file before apply.
# LocalStack paid checkout rejects placeholder/live API keys. A webhook secret
# is optional unless Stripe webhook forwarding is part of the local test.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SES_SENDER_EMAIL=noreply@eventpro.local
