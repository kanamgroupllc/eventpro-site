# Copy to .env.remote and populate with the intended real AWS account values.
WORKSPACE=dev
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
DOMAIN_NAME=

SERVICES_IMAGE_SOURCE=build
SERVICES_IMAGE_PLATFORMS=linux/amd64,linux/arm64
LAMBDAS_IMAGE_SOURCE=build
LAMBDA_IMAGE_PLATFORM=linux/amd64

# Secure default. Override only for a controlled staged rollout or emergency rollback.
EVENTPRO_CSRF_ENABLED=true

JWT_ISSUER=eventpro
JWT_ACCESS_TTL_SECONDS=3600
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ACCOUNT_ID=
SES_SENDER_EMAIL=
